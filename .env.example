# Better Auth / OAuth Configuration
# OIDC_CLIENT_ID / SECRET and MINISTRY_PLATFORM_CLIENT_ID / SECRET can be the same value.  If they are set differently, it allows
# a unique client_id and client_secret for each provider.  The OIDC client_id and client_secret are used for user login and best practice is re-use
# the same one as Widgets for congregant face applications.
OIDC_CLIENT_ID=TM.Widgets
OIDC_CLIENT_SECRET=
# CRITICAL: Generate a secure random string for BETTER_AUTH_SECRET
# This is used by Better Auth for session signing and MUST be kept secret
#
# Generate using any of these methods:
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Then store it securely (CI/CD secrets, secrets manager, etc.) and pass to container:
#   docker run -e BETTER_AUTH_SECRET="your-generated-secret" your-image
#
# IMPORTANT: Generate this ONCE and reuse the same value across deployments.
# Changing this will invalidate all existing user sessions.
BETTER_AUTH_SECRET=
# Application base URL — used for OAuth callbacks and redirects.
BETTER_AUTH_URL=http://localhost:3000

# MinistryPlatform API Configuration
# This API Client / Secret will be used for data access and will be the user for audit log data when no userId is provided.
MINISTRY_PLATFORM_CLIENT_ID=MPNext
MINISTRY_PLATFORM_CLIENT_SECRET=
MINISTRY_PLATFORM_BASE_URL=https://mpi.ministryplatform.com/ministryplatformapi

#NEXT Public Keys
NEXT_PUBLIC_MINISTRY_PLATFORM_FILE_URL=https://mpi.ministryplatform.com/ministryplatformapi/files
NEXT_PUBLIC_APP_NAME=MP Tools

# RBAC Configuration
# Super-admin User Group IDs — comma-separated
# Users in ANY of these groups have full access to all features + admin page
ADMIN_USER_GROUP_IDS=29

# Volunteer Processing Configuration
# Tab 1: In-process volunteer group(s) - comma-separated Group_IDs
VOLUNTEER_PROCESSING_GROUP_IDS=
# Tab 2: Approved volunteer role filter - comma-separated Group_Role_IDs
VOLUNTEER_APPROVED_GROUP_ROLE_IDS=13,15
# Checklist: Application form
VOLUNTEER_APPLICATION_FORM_ID=
# Program ID for creating milestones (required by Ministry Platform)
VOLUNTEER_PROGRAM_ID=305
# Checklist: Interview milestone
VOLUNTEER_INTERVIEW_MILESTONE_ID=
# Checklist: References (primary milestone ID; optional 2nd/3rd IDs for separate milestones)
VOLUNTEER_REFERENCE_MILESTONE_ID=
VOLUNTEER_REFERENCE_2_MILESTONE_ID=
VOLUNTEER_REFERENCE_3_MILESTONE_ID=
# Checklist: Fully Approved Volunteer milestone (final step in volunteer journey)
VOLUNTEER_FULLY_APPROVED_MILESTONE_ID=33
# Checklist: Elder Approved Teacher milestone (optional; shows teacher icon on card)
VOLUNTEER_ELDER_APPROVED_TEACHER_MILESTONE_ID=34
# Checklist: Mandated Reporter certification type
VOLUNTEER_MANDATED_REPORTER_CERT_TYPE_ID=10
# Checklist: Child Protection Policy form
VOLUNTEER_CHILD_PROTECTION_FORM_ID=83

# Baptism Processing Configuration
# Journey ID (from Journeys table — needed for auto-migration to journey tools)
BAPTISM_JOURNEY_ID=1
# Group for current baptism applicants
BAPTISM_CURRENT_GROUP_ID=1023
# Group for paused baptism applicants
BAPTISM_PAUSED_GROUP_ID=1024
# Program ID for creating milestones (required by Ministry Platform)
BAPTISM_PROGRAM_ID=306
# Default group role when moving between groups
BAPTISM_DEFAULT_GROUP_ROLE_ID=2
# Milestones (in process order)
BAPTISM_APPLICATION_MILESTONE_ID=26
BAPTISM_CONFIRMATION_EMAIL_MILESTONE_ID=41
BAPTISM_SCHEDULED_INTERVIEW_MILESTONE_ID=39
BAPTISM_COMPLETED_INTERVIEW_MILESTONE_ID=25
BAPTISM_APPROVED_MILESTONE_ID=38
BAPTISM_INFO_REQUEST_EMAIL_MILESTONE_ID=37
BAPTISM_ITEMS_RECEIVED_MILESTONE_ID=36
BAPTISM_SCHEDULED_MILESTONE_ID=35
BAPTISM_CAPSTONE_MILESTONE_ID=3
# Special: Pause milestone (triggers group move)
BAPTISM_PAUSED_MILESTONE_ID=40

# Membership Processing Configuration
# Journey ID (from Journeys table — needed for auto-migration to journey tools)
MEMBERSHIP_JOURNEY_ID=2
# Group for membership applicants
MEMBERSHIP_GROUP_ID=1025
# Program ID for creating milestones (required by Ministry Platform)
MEMBERSHIP_PROGRAM_ID=307
# Default group role for applicants
MEMBERSHIP_DEFAULT_GROUP_ROLE_ID=2
# Milestones (in process order)
MEMBERSHIP_PRE_APPLICATION_MILESTONE_ID=27
MEMBERSHIP_APPLICATION_MILESTONE_ID=42
MEMBERSHIP_STARTED_CLASS_MILESTONE_ID=43
MEMBERSHIP_COMPLETED_CLASS_MILESTONE_ID=44
MEMBERSHIP_APPROVED_BY_LC_MILESTONE_ID=45
MEMBERSHIP_LISTED_IN_BULLETIN_MILESTONE_ID=46
MEMBERSHIP_PRESENTED_TO_CONGREGATION_MILESTONE_ID=47
# Final milestone: completing this ends group participation
MEMBERSHIP_REGISTERED_MEMBER_MILESTONE_ID=48
